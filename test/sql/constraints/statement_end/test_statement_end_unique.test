# name: test/sql/constraints/statement_end/test_statement_end_unique.test
# description: Unique keys are checked once at the end of a statement, so keys can move between rows within it
# group: [statement_end]

statement ok
CREATE TABLE t (id INTEGER PRIMARY KEY, v INTEGER);

statement ok
INSERT INTO t SELECT i, i FROM range(5000) t(i);

# shifting all keys by one crosses many chunks
statement ok
UPDATE t SET id = id + 1;

query III
SELECT count(*), min(id), max(id) FROM t;
----
5000	1	5000

statement ok
BEGIN;

statement ok
UPDATE t SET id = id - 1;

statement ok
UPDATE t SET id = 4999 - id;

statement ok
COMMIT;

query II
SELECT id, v FROM t WHERE id IN (0, 4999) ORDER BY id;
----
0	4999
4999	0

# the errors and their texts are the statement-time ones, in autocommit and in a transaction
statement error
INSERT INTO t VALUES (7, 0);
----
<REGEX>:Constraint Error: Duplicate key "id: 7" violates primary key constraint.*

statement error
INSERT INTO t VALUES (6000, 0), (6000, 1);
----
<REGEX>:Constraint Error: PRIMARY KEY or UNIQUE constraint violation: duplicate key "6000".*

statement error
UPDATE t SET id = 3 WHERE id = 4;
----
<REGEX>:Constraint Error: Duplicate key "id: 3" violates primary key constraint.*

statement ok
BEGIN;

statement error
INSERT INTO t VALUES (7, 0);
----
<REGEX>:Constraint Error: Duplicate key "id: 7" violates primary key constraint.*

statement ok
ROLLBACK;

statement ok
BEGIN;

statement ok
INSERT INTO t VALUES (6000, 0);

statement error
INSERT INTO t VALUES (6000, 1);
----
<REGEX>:Constraint Error: PRIMARY KEY or UNIQUE constraint violation: duplicate key "6000".*

statement ok
ROLLBACK;

# a failing autocommit statement with RETURNING returns the error and no rows
statement error
INSERT INTO t VALUES (8000, 0), (8, 0) RETURNING id;
----
<REGEX>:Constraint Error: Duplicate key "id: 8" violates primary key constraint.*

query I
SELECT count(*) FROM t WHERE id = 8000;
----
0

# deleted keys can be inserted again by the same or a later statement
statement ok
BEGIN;

statement ok
DELETE FROM t WHERE id < 100;

statement ok
INSERT INTO t SELECT i, -i FROM range(100) t(i);

statement error
INSERT INTO t VALUES (50, 0);
----
<REGEX>:Constraint Error: PRIMARY KEY or UNIQUE constraint violation: duplicate key "50".*

statement ok
ROLLBACK;

query II
SELECT count(*), count(DISTINCT id) FROM t;
----
5000	5000

# the transaction-local rows inserted and deleted in one transaction
statement ok
BEGIN;

statement ok
INSERT INTO t VALUES (9000, 0);

statement ok
DELETE FROM t WHERE id = 9000;

statement ok
INSERT INTO t VALUES (9000, 1);

statement ok
COMMIT;

query I
SELECT v FROM t WHERE id = 9000;
----
1

# ON CONFLICT and INSERT OR REPLACE are resolved by the join of MERGE
statement ok
CREATE TABLE l (id INTEGER PRIMARY KEY, arr INTEGER[]);

statement ok
INSERT INTO l VALUES (1, [1]), (2, [2]);

statement ok
INSERT OR REPLACE INTO l VALUES (1, [10]);

statement ok
INSERT INTO l VALUES (2, [20]) ON CONFLICT DO UPDATE SET arr = excluded.arr;

statement ok
MERGE INTO l USING (SELECT 1 AS id) s ON l.id = s.id WHEN MATCHED THEN UPDATE SET arr = [100];

query II
SELECT id, arr FROM l ORDER BY id;
----
1	[100]
2	[20]
