# name: test/sql/parallelism/interquery/concurrent_checkpoint_fk_delete_delta.test_slow
# description: FK delete checks against checkpoint REMOVED deltas holding multiple row ids per key
# group: [interquery]

statement ok
ATTACH ':memory:' AS mem

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_checkpoint_sleep_ms=3000

statement ok
ATTACH '{TEST_DIR}/concurrent_checkpoint_fk_delete_delta.db' AS db1

# work-around for not being able to create fk tables in other databases
statement ok
USE db1

statement ok
CREATE TABLE parent(pk INTEGER PRIMARY KEY)

statement ok
CREATE TABLE child(id INTEGER, fk INTEGER REFERENCES parent(pk))

statement ok
INSERT INTO parent SELECT range FROM range(100)

# two children per parent: the FOREIGN index holds two row ids per key
statement ok
INSERT INTO child SELECT range, range % 100 FROM range(200)

statement ok
USE mem

concurrentloop threadid 0 2

# keep a write transaction open so the checkpoint runs concurrently
onlyif threadid=1
statement ok
BEGIN

onlyif threadid=1
statement ok
INSERT INTO db1.parent VALUES (1000)

onlyif threadid=0
sleep 400 millisecond

onlyif threadid=0
statement ok
CHECKPOINT db1

# the checkpoint is now registered and sleeping; commit and delete during its window
onlyif threadid=1
sleep 1000 millisecond

onlyif threadid=1
statement ok
COMMIT

# deleting both children routes a two-row-id leaf into the REMOVED delta
onlyif threadid=1
statement ok
DELETE FROM db1.child WHERE fk = 1

# no children left: the parent delete must succeed
onlyif threadid=1
statement ok
DELETE FROM db1.parent WHERE pk = 1

# deleting one child leaves a live child in the FOREIGN index
onlyif threadid=1
statement ok
DELETE FROM db1.child WHERE id = 2

# one child remains: the parent delete must fail
onlyif threadid=1
statement error
DELETE FROM db1.parent WHERE pk = 2
----
<REGEX>:.*still referenced.*

endloop

query I
SELECT count(*) FROM db1.child WHERE fk = 1
----
0

query I
SELECT count(*) FROM db1.parent WHERE pk = 1
----
0

query II
SELECT id, fk FROM db1.child WHERE fk = 2 ORDER BY id
----
102	2

query I
SELECT count(*) FROM db1.parent WHERE pk = 2
----
1

# the deltas merge back into the main index at checkpoint end
statement ok
SET debug_checkpoint_sleep_ms=0

statement ok
CHECKPOINT db1

statement error
DELETE FROM db1.parent WHERE pk = 2
----
<REGEX>:.*still referenced.*

statement ok
DELETE FROM db1.child WHERE id = 102

statement ok
DELETE FROM db1.parent WHERE pk = 2

statement ok
DELETE FROM db1.parent WHERE pk = 1000
