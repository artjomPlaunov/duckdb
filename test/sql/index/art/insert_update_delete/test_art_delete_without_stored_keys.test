# name: test/sql/index/art/insert_update_delete/test_art_delete_without_stored_keys.test
# description: With debug_store_delete_index_values off, the commit and the cleanup fetch the deleted rows
# group: [insert_update_delete]

statement ok
SET GLOBAL debug_store_delete_index_values = false;

statement ok
CREATE TABLE t (id INTEGER PRIMARY KEY, a INTEGER, l INTEGER[]);

statement ok
CREATE INDEX t_a ON t (a);

statement ok
INSERT INTO t SELECT i, i % 10, [i] FROM range(5000) t(i);

statement ok con_old
BEGIN;

query I con_old
SELECT count(*) FROM t WHERE a = 3;
----
500

statement ok
BEGIN;

statement ok
DELETE FROM t WHERE id < 3000;

statement ok
INSERT INTO t SELECT i, -1, [] FROM range(1000) t(i);

statement ok
UPDATE t SET l = [0] WHERE id BETWEEN 3000 AND 3999;

statement ok
COMMIT;

query I con_old
SELECT count(*) FROM t WHERE a = 3;
----
500

statement ok con_old
COMMIT;

query II
SELECT count(*), count(DISTINCT id) FROM t;
----
3000	3000

query I
SELECT count(*) FROM t WHERE a = 3;
----
200

statement error
INSERT INTO t VALUES (10, 0, []);
----
<REGEX>:Constraint Error: Duplicate key "id: 10" violates primary key constraint.*

statement ok
INSERT INTO t VALUES (2000, 0, []);

statement ok
SET GLOBAL debug_store_delete_index_values = true;
