# name: test/sql/index/art/insert_update_delete/test_art_delete_stored_keys.test
# description: Deletes remove their keys from every kind of index, with the indexed values stored at the delete
# group: [insert_update_delete]

require skip_reload

load {TEST_DIR}/delete_stored_keys.db

statement ok
SET checkpoint_threshold = '1TB';

statement ok
CREATE TABLE p (id INTEGER PRIMARY KEY, u VARCHAR UNIQUE, a INTEGER, b VARCHAR, l INTEGER[], payload VARCHAR);

statement ok
CREATE INDEX p_ab ON p (a, b);

statement ok
CREATE INDEX p_expr ON p ((a + 1));

statement ok
CREATE TABLE c (pid INTEGER REFERENCES p (id), v INTEGER);

statement ok
INSERT INTO p SELECT i, 'u' || i, i % 10, 'b' || (i % 7), [i], 'x' || i FROM range(5000) t(i);

statement ok
INSERT INTO c SELECT i, i FROM range(0, 5000, 2) t(i);

statement ok
CHECKPOINT;

# plain delete through every index kind, including the child's foreign key index
statement ok
DELETE FROM c WHERE pid < 1000;

statement ok
DELETE FROM p WHERE id < 1000;

query I
SELECT count(*) FROM p WHERE id = 10;
----
0

query I
SELECT count(*) FROM p WHERE a = 3 AND b = 'b3';
----
57

statement ok
INSERT INTO p SELECT i, 'u' || i, -1, 'new', [i], 'y' FROM range(1000) t(i);

query I
SELECT count(*) FROM p WHERE a = -1 AND b = 'new';
----
1000

statement ok
INSERT INTO c VALUES (10, 10);

# a delete with RETURNING
query I
DELETE FROM p WHERE id = 1 RETURNING u;
----
u1

statement ok
INSERT INTO p VALUES (1, 'u1', 0, 'z', [], NULL);

# DELETE ... USING with duplicate matches
statement ok
CREATE TABLE dup AS SELECT 2001 + 2 * (i % 5) AS k FROM range(20) t(i);

query I
DELETE FROM p USING dup WHERE p.id = dup.k;
----
5

statement ok
INSERT INTO p SELECT k, 'u' || k, 0, 'dup', [], NULL FROM (SELECT DISTINCT k FROM dup);

query I
SELECT count(*) FROM p WHERE b = 'dup' AND a = 0;
----
5

# an update of a LIST column is a delete and an insert that keeps the keys
statement ok
UPDATE p SET l = [42] WHERE id BETWEEN 3000 AND 3999 AND id % 2 = 1;

query I
SELECT count(*) FROM p WHERE id BETWEEN 3000 AND 3999 AND l = [42];
----
500

# an update of an indexed column
statement ok
UPDATE p SET a = a + 100, u = u || '_x' WHERE id BETWEEN 4000 AND 4999 AND id % 2 = 1;

query I
SELECT count(*) FROM p WHERE (a + 1) BETWEEN 101 AND 110;
----
500

query I
SELECT count(*) FROM p WHERE u = 'u4001';
----
0

statement ok
INSERT INTO p VALUES (-4001, 'u4001', 0, 'reuse', [], NULL);

statement error
INSERT INTO p VALUES (-4003, 'u4003_x', 0, 'dup', [], NULL);
----
<REGEX>:Constraint Error.*Duplicate key.*

statement ok
CHECKPOINT;

restart

statement ok
SET checkpoint_threshold = '1TB';

query I
SELECT count(*) FROM p WHERE a = 3 AND b = 'b3';
----
43

# deletes replayed from the WAL carry only row ids
statement ok
DELETE FROM c WHERE pid BETWEEN 1000 AND 2500;

statement ok
DELETE FROM p WHERE id BETWEEN 1000 AND 1999;

statement ok
DELETE FROM p WHERE u = 'u2500';

restart

statement ok
INSERT INTO p SELECT i, 'u' || i, 0, 'replayed', [], NULL FROM range(1000, 2000) t(i);

statement ok
INSERT INTO p VALUES (2500, 'u2500', 0, 'replayed', [], NULL);

query I
SELECT count(*) FROM p WHERE b = 'replayed' AND a = 0;
----
1001

statement error
INSERT INTO p VALUES (1500, 'other', 0, 'x', [], NULL);
----
<REGEX>:Constraint Error.*Duplicate key "id: 1500".*

query II
SELECT count(*), count(DISTINCT id) FROM p;
----
5001	5001
