# name: test/sql/index/art/constraints/test_art_failed_commit_delete_reinsert.test
# description: A commit that fails after deleting and re-inserting a key leaves the old row and a consistent index
# group: [constraints]

# the forced commit failure crashes the alternative-verify build
require no_alternative_verify

require skip_reload

load {TEST_DIR}/failed_commit_delete_reinsert.db

statement ok
CREATE TABLE t (id INTEGER PRIMARY KEY, v VARCHAR);

statement ok
CREATE INDEX t_v ON t (v);

statement ok
INSERT INTO t VALUES (1, 'old'), (2, 'two');

statement ok
SET GLOBAL debug_force_commit_failure = true;

statement ok
BEGIN;

statement ok
DELETE FROM t WHERE id = 1;

statement ok
INSERT INTO t VALUES (1, 'new');

statement error
COMMIT;
----
Forced commit failure

statement ok
SET GLOBAL debug_force_commit_failure = false;

query II
SELECT id, v FROM t ORDER BY id;
----
1	old
2	two

query I
SELECT v FROM t WHERE id = 1;
----
old

query I
SELECT id FROM t WHERE v = 'old';
----
1

query I
SELECT count(*) FROM t WHERE v = 'new';
----
0

statement error
INSERT INTO t VALUES (1, 'dup');
----
<REGEX>:Constraint Error.*Duplicate key "id: 1".*

# the same delete and re-insert commits now
statement ok
BEGIN;

statement ok
DELETE FROM t WHERE id = 1;

statement ok
INSERT INTO t VALUES (1, 'new');

statement ok
COMMIT;

query II
SELECT id, v FROM t ORDER BY id;
----
1	new
2	two

query I
SELECT v FROM t WHERE id = 1;
----
new

query I
SELECT count(*) FROM t WHERE v = 'old';
----
0

statement error
INSERT INTO t VALUES (1, 'dup');
----
<REGEX>:Constraint Error.*Duplicate key "id: 1".*

# a failed commit with an index created in the same transaction
statement ok
SET GLOBAL debug_force_commit_failure = true;

statement ok
BEGIN;

statement ok
DELETE FROM t WHERE id = 2;

statement ok
INSERT INTO t VALUES (2, 'second');

statement ok
CREATE INDEX t_v2 ON t (v);

statement error
COMMIT;
----
Forced commit failure

statement ok
SET GLOBAL debug_force_commit_failure = false;

query II
SELECT id, v FROM t ORDER BY id;
----
1	new
2	two

query I
SELECT v FROM t WHERE id = 2;
----
two

statement error
INSERT INTO t VALUES (2, 'dup');
----
<REGEX>:Constraint Error.*Duplicate key "id: 2".*

statement ok
CHECKPOINT;

restart

query II
SELECT id, v FROM t ORDER BY id;
----
1	new
2	two

query I
SELECT v FROM t WHERE id = 2;
----
two

statement error
INSERT INTO t VALUES (2, 'dup');
----
<REGEX>:Constraint Error.*Duplicate key "id: 2".*
