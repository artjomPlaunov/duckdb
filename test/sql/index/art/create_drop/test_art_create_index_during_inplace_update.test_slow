# name: test/sql/index/art/create_drop/test_art_create_index_during_inplace_update.test_slow
# description: An update planned before CREATE INDEX that commits after the index is published fails instead of leaving a stale key
# group: [create_drop]

statement ok
CREATE TABLE t AS SELECT range AS k, range AS v FROM range(2000000);

concurrentforeach role con_u con_x

onlyif role=con_x
statement maybe
CREATE INDEX idx_v ON t(v);
----
Cannot create index with outstanding updates

# con_u: updates v in place after the build scanned the row, and commits during the build or after the publish
onlyif role=con_u
sleep 40 millisecond

onlyif role=con_u
statement ok
BEGIN;

onlyif role=con_u
statement ok
UPDATE t SET v = -1 WHERE k = 0;

onlyif role=con_u
sleep 3000 millisecond

onlyif role=con_u
statement maybe
COMMIT;
----
another transaction has created an index on an updated column

endloop

statement ok
CREATE INDEX IF NOT EXISTS idx_v ON t(v);

# the index agrees with the table, whichever statement failed
query I
SELECT count(*) FROM t WHERE v = 0;
----
<REGEX>:[01]

query I
SELECT (SELECT count(*) FROM t WHERE v = 0) + (SELECT count(*) FROM t WHERE v = -1);
----
1

query I
SELECT count(*) FROM t WHERE v = 0 AND k <> 0;
----
0

statement ok
DELETE FROM t WHERE k < 10;

query I
SELECT count(*) FROM t WHERE v < 10;
----
0
