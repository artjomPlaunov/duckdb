# name: test/sql/index/art/create_drop/test_art_create_index_during_rejected_update_commit.test_slow
# description: A commit with a rejected in-place update of a column being indexed fails cleanly after a delete and insert of a unique key
# group: [create_drop]

set always_fail_error_messages FATAL, invalidated, INTERNAL

statement ok
SET threads=2

statement ok
CREATE TABLE t(id BIGINT, u BIGINT UNIQUE, k BIGINT, s STRUCT(a BIGINT, b BIGINT));

statement ok
INSERT INTO t SELECT i, i, i, {'a': i, 'b': i} FROM range(4000000) r(i);

statement ok
CREATE TABLE other(id BIGINT, k BIGINT);

statement ok
INSERT INTO other SELECT i, i FROM range(4000000) r(i);

# the update of u runs as a delete and an insert, the update of the indexed column runs in place
foreach target t(k) other(k) t((s.a))

concurrentforeach role con_t con_x

onlyif role=con_x
statement maybe
CREATE INDEX idx_build ON ${target};
----
outstanding updates

onlyif role=con_t
statement ok
BEGIN

onlyif role=con_t
statement ok
UPDATE t SET u = u WHERE id < 10

onlyif role=con_t
sleep 20 millisecond

onlyif role=con_t
statement ok
UPDATE t SET k = k + 1, s = {'a': s.a + 1, 'b': s.b} WHERE id = 100

onlyif role=con_t
statement ok
UPDATE other SET k = k + 1 WHERE id = 100

onlyif role=con_t
sleep 200 millisecond

onlyif role=con_t
statement maybe
COMMIT
----
another transaction has created an index on an updated column

endloop

statement ok
CREATE INDEX IF NOT EXISTS idx_build ON ${target};

query I
SELECT count(*) FROM t WHERE u = 5
----
1

statement error
INSERT INTO t VALUES (5000000, 5, 0, {'a': 0, 'b': 0})
----
<REGEX>:Constraint Error.*Duplicate key.*

query I
SELECT (SELECT count(*) FROM t WHERE k BETWEEN 99 AND 102) = (SELECT count(*) FROM t WHERE k BETWEEN 99 AND 102 AND hash(k) IS NOT NULL)
----
true

query I
SELECT (SELECT count(*) FROM other WHERE k BETWEEN 99 AND 102) = (SELECT count(*) FROM other WHERE k BETWEEN 99 AND 102 AND hash(k) IS NOT NULL)
----
true

query I
SELECT (SELECT count(*) FROM t WHERE s.a BETWEEN 99 AND 102) = (SELECT count(*) FROM t WHERE s.a BETWEEN 99 AND 102 AND hash(s.a) IS NOT NULL)
----
true

statement ok
DROP INDEX idx_build

endloop
