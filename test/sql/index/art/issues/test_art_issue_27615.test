# name: test/sql/index/art/issues/test_art_issue_27615.test
# description: Issue 27615: a commit after DELETE, ADD COLUMN and CREATE INDEX on the new column must not be fatal
# group: [issues]

statement ok
CREATE TABLE t (i INTEGER PRIMARY KEY, j INTEGER);

statement ok
INSERT INTO t SELECT range, range FROM range(10);

statement ok
BEGIN;

statement ok
DELETE FROM t WHERE i < 3;

statement ok
ALTER TABLE t ADD COLUMN k INTEGER DEFAULT 7;

statement ok
CREATE INDEX t_k ON t (k);

statement ok
COMMIT;

query I
SELECT count(*) FROM t WHERE k = 7;
----
7

query I
SELECT count(*) FROM t WHERE i = 1;
----
0

statement ok
INSERT INTO t VALUES (1, 1, 8);

query I
SELECT i FROM t WHERE k = 8;
----
1
