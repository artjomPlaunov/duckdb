# name: test/sql/index/art/delete_merge/test_delete_merge_checkpoint.test_slow
# description: Delete-merge commits during a checkpoint route through the checkpoint deltas
# group: [delete_merge]

statement ok
ATTACH ':memory:' AS mem

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_checkpoint_sleep_ms=3000

statement ok
ATTACH '{TEST_DIR}/delete_merge_checkpoint.db' AS db1

statement ok
CREATE TABLE db1.t(i INTEGER PRIMARY KEY, j INTEGER)

statement ok
INSERT INTO db1.t SELECT range, range FROM range(10000)

statement ok
USE mem

concurrentloop threadid 0 2

# keep a write transaction open so the checkpoint runs concurrently
onlyif threadid=1
statement ok
BEGIN

onlyif threadid=1
statement ok
INSERT INTO db1.t VALUES (100000, 0)

onlyif threadid=0
sleep 400 millisecond

onlyif threadid=0
statement ok
CHECKPOINT db1

# the checkpoint is registered and sleeping; commit deletes and PK updates during its window
onlyif threadid=1
sleep 1000 millisecond

onlyif threadid=1
statement ok
COMMIT

# rows committed during the checkpoint land in added_data
onlyif threadid=1
statement ok
INSERT INTO db1.t SELECT range, -2 FROM range(20000, 21000)

# a delete spanning pre-checkpoint rows (main) and rows added during it (added_data)
onlyif threadid=1
statement ok
DELETE FROM db1.t WHERE i < 2000 OR i >= 20500

onlyif threadid=1
statement ok
UPDATE db1.t SET i = i + 20000 WHERE i >= 9000 AND i < 10000

onlyif threadid=1
statement ok
INSERT INTO db1.t SELECT range, -1 FROM range(2000)

endloop

statement ok
USE db1

# 0..8999 live below 10000; 9000..9999 moved to 29000..29999; 20000..20499 remain of the mid-checkpoint insert
query III
SELECT count(*) FILTER (i < 10000), count(*) FILTER (i >= 29000 AND i < 30000), count(*) FILTER (i >= 20000 AND i < 21000) FROM t
----
9000	1000	500

statement error
INSERT INTO t VALUES (5000, 0)
----
<REGEX>:Constraint Error.*

statement error
INSERT INTO t VALUES (20000, 0)
----
<REGEX>:Constraint Error.*

# the deleted and freed keys are reusable
statement ok
INSERT INTO t SELECT range, -1 FROM range(9000, 10000)

statement ok
INSERT INTO t SELECT range, -3 FROM range(20500, 21000)

# re-attach: verify the persisted state (checkpoint + WAL replay)
statement ok
USE mem

statement ok
DETACH db1

statement ok
ATTACH '{TEST_DIR}/delete_merge_checkpoint.db' AS db1

query II
SELECT count(*) FILTER (i < 10000), count(*) FILTER (i >= 20000 AND i < 21000) FROM db1.t
----
10000	1000
