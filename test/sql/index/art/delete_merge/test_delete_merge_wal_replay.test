# name: test/sql/index/art/delete_merge/test_delete_merge_wal_replay.test
# description: WAL replay of deletes and PK updates keeps the indexes correct (replay uses the fetch path)
# group: [delete_merge]

require skip_reload

load __TEST_DIR__/delete_merge_wal_replay.db

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
SET checkpoint_threshold='1TB';

statement ok
CREATE TABLE t(i INTEGER PRIMARY KEY, j INTEGER);

statement ok
INSERT INTO t SELECT range, range FROM range(1000);

statement ok
CHECKPOINT;

statement ok
DELETE FROM t WHERE i < 300;

# reuse the freed keys: 700..999 move onto the deleted 0..299
statement ok
UPDATE t SET i = i - 700 WHERE i >= 700;

query II
SELECT count(*), min(i) FROM t;
----
700	0

restart

query II
SELECT count(*), min(i) FROM t;
----
700	0

# the replayed deletes and updates left the index: the moved-out keys are reusable
statement ok
INSERT INTO t SELECT range, -1 FROM range(700, 1000);

query I
SELECT count(*) FROM t;
----
1000

statement error
INSERT INTO t VALUES (0, 0);
----
<REGEX>:Constraint Error.*

# an index created after same-transaction deletes: its WAL image still holds the deleted keys,
# but replaying the deletes removes them again at the replay commit
statement ok
CREATE TABLE new_idx(a INTEGER, b INTEGER);

statement ok
INSERT INTO new_idx VALUES (1, 10), (2, 20), (3, 30);

statement ok
BEGIN;

statement ok
DELETE FROM new_idx WHERE a = 1;

statement ok
CREATE UNIQUE INDEX idx_new_b ON new_idx(b);

statement ok
COMMIT;

statement ok
CREATE TABLE new_pk(a INTEGER UNIQUE, b INTEGER);

statement ok
INSERT INTO new_pk VALUES (1, 10), (2, 20), (3, 30);

statement ok
BEGIN;

statement ok
DELETE FROM new_pk WHERE a = 1;

statement ok
ALTER TABLE new_pk ADD PRIMARY KEY (b);

statement ok
COMMIT;

restart

# the deleted rows' keys must be reusable on the new indexes
statement ok
INSERT INTO new_idx VALUES (1, 10);

statement ok
INSERT INTO new_pk VALUES (1, 10);

query II
SELECT a, b FROM new_idx ORDER BY a;
----
1	10
2	20
3	30

query II
SELECT a, b FROM new_pk ORDER BY a;
----
1	10
2	20
3	30

# indexes created BEFORE deletes in the same transaction: the replayed DELETE records come after
# the CREATE INDEX record, but the serialized image predates the commit's removal of the rows
statement ok
CREATE TABLE strip1(a INTEGER, b INTEGER);

statement ok
INSERT INTO strip1 VALUES (1, 10), (2, 20), (3, 30);

statement ok
BEGIN;

statement ok
CREATE UNIQUE INDEX idx_strip1_b ON strip1(b);

statement ok
DELETE FROM strip1 WHERE a = 1;

statement ok
COMMIT;

# delete plus an insert of a fresh key after creating the index in the same transaction
statement ok
CREATE TABLE strip2(a INTEGER, b INTEGER);

statement ok
INSERT INTO strip2 VALUES (1, 10), (2, 20), (3, 30);

statement ok
BEGIN;

statement ok
CREATE UNIQUE INDEX idx_strip2_b ON strip2(b);

statement ok
DELETE FROM strip2 WHERE a = 1;

statement ok
INSERT INTO strip2 VALUES (4, 40);

statement ok
COMMIT;

restart

# the deleted keys must be reusable, the inserted key must still conflict
statement ok
INSERT INTO strip1 VALUES (1, 10);

statement ok
INSERT INTO strip2 VALUES (1, 10);

statement error
INSERT INTO strip2 VALUES (5, 40);
----
<REGEX>:Constraint Error.*

query II
SELECT a, b FROM strip1 ORDER BY a;
----
1	10
2	20
3	30

query II
SELECT a, b FROM strip2 ORDER BY a;
----
1	10
2	20
3	30
4	40
